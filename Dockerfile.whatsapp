# Ponte do WhatsApp (whatsapp/ponte.js): Node + Chromium do sistema.
# O whatsapp-web.js abre o WhatsApp Web num Chromium sem tela.

FROM node:22-bookworm-slim

# Chromium, fontes com emoji (o WhatsApp Web precisa delas) e git (a
# biblioteca do WhatsApp vem de uma versão do GitHub com correção de envio
# de imagem para canal que ainda não saiu no npm).
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium fonts-noto-color-emoji ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    CHROMIUM_PATH=/usr/bin/chromium \
    PASTA_DADOS=/dados

# A imagem do Node já tem o usuário comum "node" (id 1000), o mesmo id do
# container do robô: os dois podem ler e escrever a pasta de dados.
USER node
WORKDIR /home/node/ponte

COPY --chown=node whatsapp/package.json whatsapp/package-lock.json ./
RUN npm ci --omit=dev

COPY --chown=node whatsapp/ponte.js ./
CMD ["node", "ponte.js"]
