# Copie este arquivo para ".env" e preencha com as suas chaves.
# NUNCA envie o .env para ninguém nem para o GitHub.

# PhotoRoom (ambientação). A chave sandbox é grátis, mas a imagem sai com marca d'água.
PHOTOROOM_SANDBOX_KEY=sandbox_coloque_sua_chave_aqui
# PHOTOROOM_LIVE_KEY=coloque_sua_chave_paga_aqui

# Anthropic / Claude (visão e headline).
ANTHROPIC_API_KEY=sk-ant-coloque_sua_chave_aqui

# @ do canal, usado na marca d'água da imagem (opcional).
CANAL_ARROBA=@seucanal

# Código secreto do link do app web. Quem tiver o link entra, então use algo
# longo e aleatório. Para gerar um: python -c "import secrets;print(secrets.token_urlsafe(18))"
APP_TOKEN=troque_por_um_codigo_longo_e_aleatorio
